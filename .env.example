# Backend Environment Variables

# Port for the server
PORT=5000

# Node environment
NODE_ENV=development

# MongoDB connection for persistent rooms.
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/nexus
# Atlas:
# MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/nexus?retryWrites=true&w=majority
#
# Use a Database Access user from Atlas, not your Atlas login email.
# If the password has @, #, /, ?, %, &, +, or spaces, URL-encode it first.
MONGODB_URI=mongodb://127.0.0.1:27017/nexus
MONGODB_DB=nexus
